# Copy this file to apps/portal/.env (which is gitignored) and fill in real values.
# These are baked into the client bundle at build time, so the API key is only
# weak protection — see arcade-api/_security.php for the full anti-spam stack.

# Base URL of the PHP API, no trailing slash. Same-origin relative path, so the
# portal works on both dulzoltan.hu and www.dulzoltan.hu (the latter is 301-redirected).
VITE_ARCADE_API_BASE=/arcade/api

# Same string as `api_key` in arcade-api/_config.php on the server.
VITE_ARCADE_API_KEY=CHANGE_ME_TO_MATCH_SERVER
